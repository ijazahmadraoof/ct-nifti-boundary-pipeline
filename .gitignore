# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# IDE / editor settings
.vscode/
.idea/

# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini

# Python packaging / build output
build/
dist/
*.egg-info/
.eggs/

# Test / coverage output
.pytest_cache/
.coverage
htmlcov/

# Logs and temporary files
*.log
*.tmp
*.temp
~$*

# Local environment / secrets
.env
.env.*
!.env.example

# Large or private scientific data
*.nii
*.nii.gz
*.npy
*.npz
*.dcm

# Generated geometry / simulation outputs
*.stl
*.vtk
*.vtu
*.pvtu

# Local result folders that may contain generated output
results/*
!results/.gitkeep

# Keep repository placeholders
!.gitkeep

# Private/local research datasets
local_data/
